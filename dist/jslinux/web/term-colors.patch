+/* get the attribute handle for a fg/bg/flags combination, allocating a
+   new one when first seen; handles are limited to 15 bits so the packed
+   cell integers stay positive */
+Term.prototype.intern_attr = function(fg, bg, flags)
+{
+    var key, id;
+    if (fg == 7 && bg == 0 && flags == 0)
+        return 0;
+    key = fg + "," + bg + "," + flags;
+    id = this.attr_hash[key];
+    if (id === undefined) {
+        id = this.attr_defs.length;
+        if (id > 0x7fff) {
+            /* table full (unlikely): degrade to the default attribute */
+            return 0;
+        }
+        this.attr_defs[id] = [fg, bg, flags];
+        this.attr_hash[key] = id;
+    }
+    return id;
+};
+
+/* CSS color for a fg/bg value stored in an attr_defs entry */
+Term.prototype.attr_color = function(c)
+{
+    if (c >= 0x1000000)
+        return "#" + (0x1000000 | (c & 0xffffff)).toString(16).substr(1);
+    return this.colors[c];
+};
