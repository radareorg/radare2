
if get_option('enable_tests')
  tests = [
    'addr_interval',
    'agraph',
    'anal_block',
    'anal_cc',
    'anal_class_graph',
    'anal_function',
    'anal_hints',
    'anal_meta',
    'anal_types',
    'anal_var',
    'anal_xrefs',
    'anal_x86',
    'arena',
    'asn1',
    'axml',
    'codemeta',
    'base36',
    'base64',
    'big',
    'bin',
    'bin_create',
    'bin_demangle',
    'bin_ningb',
    'bin_trycatch',
    'bitmap',
    'bitset',
    'bloom',
    'buf',
    'cmd_str',
    'cmd_api',
    'config',
    'cons',
    'core_bin_classes',
    'core_disasm',
    'core_esil',
    'core_prompt',
    'core_slides',
    'core_task',
    'debruijn',
    'debug',
    'debug_liveness',
    'debug_session',
    'diff',
    'dwarf',
    'dwarf_info',
    'dwarf_integration',
    'esil',
    'esil_dfg_filter',
    'egg_lang',
    'event',
    'flags',
    'fs',
    'gdb',
    'glob',
    'graph',
    'hex',
    'id_storage',
    'idpool',
    'idstorage',
    'intervaltree',
    'io',
    'json',
    'kernelcache_cmdsize',
    'lang',
    'list',
    'lz4',
    'muta',
    'ovf',
    'pdb',
    'pj',
    'print',
    'queue',
    'r2pipe',
    'r2r',
    'rbtree',
    'reg',
    'sign',
    'skiplist',
    'socket',
    'spaces',
    'sparse',
    'stack',
    'str',
    'strbuf',
    'strpool',
    'strpool_oom',
    'scanf',
    'printf',
    'table',
    'thread',
    'tree',
    'trie',
    'uleb128',
    'unum',
    'util',
    'vec',
    'crbtree',
    'visual_hints',
    'winkd',
    'xpatch'
  ]

  if not use_syslib_magic
    tests += ['magic']
  endif

  foreach test : tests
    test_inc = [platform_inc]
    if test == 'bin_demangle'
      test_inc += java_inc
    endif
    exe = executable('test_@0@'.format(test), 'test_@0@.c'.format(test),
      include_directories: test_inc,
      dependencies: [
        r_util_dep,
        r_main_dep,
        r_socket_dep,
        r_core_dep,
        r_io_dep,
        r_fs_dep,
        r_esil_dep,
        r_bin_dep,
        r_flag_dep,
        r_cons_dep,
        r_asm_dep,
        r_arch_dep,
        r_debug_dep,
        r_config_dep,
        r_bp_dep,
        r_reg_dep,
        r_syscall_dep,
        r_anal_dep,
        r_egg_dep,
        r_search_dep,
        r_muta_dep,
        r_magic_dep,
        gdb_dep,
        winkd_dep,
        lrt,
      ],
      install: false,
      install_rpath: rpath_exe,
      implicit_include_directories: false
    )
    test(test, exe, workdir: join_paths(meson.current_source_dir(), '..'))
  endforeach
endif
