NAME=V850 ADDI into r0 updates flags without using r0 as a temporary
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=v850
e asm.cpu=e1
wx 010620ff
aei
aer r1=224
aes
aer r1
aer psw
EOF
EXPECT=<<EOF
0x000000e0
0x00000009
EOF
RUN

