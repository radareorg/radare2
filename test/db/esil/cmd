NAME=cmd.esil.trap
FILE=malloc://512
CMDS=<<EOF
e cmd.esil.trap=?e hello world
ae 2,1,TRAP
EOF
EXPECT=<<EOF
hello world 1 2
EOF
RUN

NAME=cmd.esil.trap via invalid pc
FILE=malloc://512
ARGS=-a x86 -b 64
CMDS=<<EOF
e cmd.esil.trap=?e its a trap
dr PC=0xdeadbeef
aes
EOF
EXPECT=<<EOF
its a trap 3735928559 3735928559
EOF
EXPECT_ERR=<<EOF
ERROR: ESIL stopped at 0xdeadbeef: execute error (execute-err at 0xdeadbeef)
EOF
RUN

NAME=cmd.esil.trap via invalid op
FILE=malloc://512
ARGS=-a x86 -b 64
CMDS=<<EOF
e cmd.esil.trap=?e its a trap
e io.cache=1
wx ffffffffffffffffffffffffffffffffffffffff
ao~type
aes
EOF
EXPECT=<<EOF
type: ill
its a trap 0 7
EOF
EXPECT_ERR=
RUN

