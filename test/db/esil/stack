NAME=esil ring exhaustion traps
FILE=--
ARGS=-e esil.stack.depth=3 -e asm.arch=x86 -e asm.bits=64
CMDS=ae 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111,rax,=
EXPECT=
EXPECT_ERR=<<EOF2
INFO: ESIL TRAP type 1 code 0x00000001 unhandled
EOF2
RUN

NAME=esil short literal with small stack does not trap
FILE=--
ARGS=-e esil.stack.depth=3 -e asm.arch=x86 -e asm.bits=64
CMDS=<<EOF2
ae 0x1234,rax,=
ar rax
EOF2
EXPECT=<<EOF2
0x00001234
EOF2
EXPECT_ERR=
RUN
