NAME=cmd.esil.trap receives step PC and full read fault address
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
wx 8b00 @ 0x10
aer rip=0x10
aer rax=0x100000005
e cmd.esil.trap=?e read
aes
ae*
e esil.nonull=true
aer rip=0x10
aer rax=0
aes
ae*
EOF
EXPECT=<<EOF
read 16 5 0 1 4294967301
trap: 5
trap-code: 0
trap-addr: 0x100000005
read 16 5 0 1 0
trap: 5
trap-code: 0
trap-addr: 0x0
EOF
EXPECT_ERR=<<EOF
ERROR: ESIL stopped at 0x00000010: read error (read-err at 0x100000005)
ERROR: ESIL stopped at 0x00000010: read error (read-err at 0x00000000)
EOF
RUN

