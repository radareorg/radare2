NAME=cmd.esil.trap returning zero stops the raw expression
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
e cmd.esil.trap=?v 0
aer rax=0x11
ae 2,1,TRAP,0x42,rax,=
aer rax
ae*
EOF
EXPECT=<<EOF
0x0
0x00000011
trap: 1
trap-code: 2
EOF
RUN

NAME=cmd.esil.trap returning one resumes successive raw traps
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
e cmd.esil.trap=?v 1
ae 2,1,TRAP,0x41,rax,=,4,2,TRAP,rax,1,+,rax,=
aer rax
ae*
EOF
EXPECT=<<EOF
0x1
0x1
0x00000042
trap: 2
trap-code: 4
EOF
RUN

NAME=cmd.esil.trap patches registers before raw continuation
