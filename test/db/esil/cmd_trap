"e cmd.esil.trap=aer rax >$registers;ae* >$crashlog;?=0"
aeq 2,1,TRAP,0x42,rax,=
$registers
$crashlog
aer rax
EOF
EXPECT=<<EOF
0x00001337
trap: 1
trap-code: 2
0x00001337
EOF
EXPECT_ERR=
RUN

