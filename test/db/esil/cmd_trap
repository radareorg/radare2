# PR #27426: dispatch step traps once with PC/code, rather than type/code then PC/code.
NAME=cmd.esil.trap fires once for a valid TRAP hint
FILE=malloc://64
ARGS=-a x86 -b 64
BROKEN=1
CMDS=<<EOF
wx 90 @ 0x10
ahe 2,1,TRAP @ 0x10
aer rip=0x10
e cmd.esil.trap=?e trap
aes
ae*
EOF
EXPECT=<<EOF
trap 16 2
trap: 1
trap-code: 2
EOF
EXPECT_ERR=<<EOF
ERROR: ESIL stopped at 0x00000010: unhandled (unhandled)
EOF
RUN

# Malformed TRAP must record invalid, and report the instruction PC.
NAME=cmd.esil.trap records invalid TRAP hints
FILE=malloc://64
ARGS=-a x86 -b 64
BROKEN=1
CMDS=<<EOF
wx 90 @ 0x10
e esil.breakoninvalid=true
e cmd.esil.trap=?e invalid
ahe TRAP @ 0x10
aer rip=0x10
aes
ae*
ahe 2,TRAP @ 0x10
aer rip=0x10
aes
ae*
ahe nope,1,TRAP @ 0x10
aer rip=0x10
aes
ae*
ahe 2,nope,TRAP @ 0x10
aer rip=0x10
aes
ae*
EOF
EXPECT=<<EOF
invalid 16 7
trap: 7
trap-code: 7
invalid 16 7
trap: 7
trap-code: 7
invalid 16 7
trap: 7
trap-code: 7
invalid 16 7
trap: 7
trap-code: 7
EOF
EXPECT_ERR=<<EOF
ERROR: ESIL stopped at 0x00000010: invalid instruction (invalid)
ERROR: ESIL stopped at 0x00000010: invalid instruction (invalid)
ERROR: ESIL stopped at 0x00000010: invalid instruction (invalid)
ERROR: ESIL stopped at 0x00000010: invalid instruction (invalid)
EOF
RUN

# The legacy VM currently receives the trap record after the crashlog hook runs.
NAME=cmd.esil.trap crashlogs contain the current step fault
FILE=malloc://64
ARGS=-a x86 -b 64
BROKEN=1
CMDS=<<EOF
wx 8b008900 @ 0x10
aer rip=0x10
aer rax=0x100000005
"e cmd.esil.trap=ae* >$crashlog;?=0"
aes
$crashlog
aer rip=0x12
aer rax=0x100000007
aes
$crashlog
EOF
EXPECT=<<EOF
trap: 5
trap-code: 0
trap-addr: 0x100000005
trap: 4
trap-code: 0
trap-addr: 0x100000007
EOF
EXPECT_ERR=<<EOF
ERROR: ESIL stopped at 0x00000010: read error (read-err at 0x100000005)
ERROR: ESIL stopped at 0x00000012: write error (write-err at 0x100000007)
EOF
RUN

