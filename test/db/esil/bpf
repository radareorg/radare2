NAME=ebpf arsh32 sign-fills a negative word
FILE=malloc://0x100
ARGS=-a bpf -b 64
CMDS=<<EOF
wx c401000001000000c401000001000000
aei
aeip
ar r1=0x80000000
aes
ar r1
ar r1=0x7ffffffe
aes
ar r1
EOF
