NAME=Z80 arithmetic sets hardware flag bits and signed overflow
FILE=malloc://0x10000
CMDS=<<EOF2
e asm.arch=z80
e asm.bits=16
aei
wx 3e7fc601
aes 2
ar a
ar f
EOF2
EXPECT=<<EOF2
0x00000080
0x00000094
EOF2
RUN

