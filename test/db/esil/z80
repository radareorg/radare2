NAME=Z80 LDIR repeats one transfer per ESIL step
FILE=malloc://0x10000
CMDS=<<EOF2
e asm.arch=z80
aei
wx edb0
e esil.skipself=false
wx 123456 @0xc000
ar hl=0xc000
ar de=0xc100
ar bc=3
aes 3
ar pc
ar bc
ar hl
ar de
pxj 3 @0xc100
EOF2
EXPECT=<<EOF2
0x00000002
0x00000000
0x0000c003
0x0000c103
[18,52,86]
EOF2
RUN

