NAME=anal.chain x86 call through incremental linking jmp thunk
FILE=bins/pe/cpp_sample.exe
CMDS=<<EOF
aa
pi 1 @ 0x140001544
pi 1 @ 0x140001131
axt @ 0x140001930~0x140001544
ah. @ 0x140001544
EOF
EXPECT=<<EOF
call fcn.140001930
jmp fcn.140001930
fcn.140001510 0x140001544 [CALL:--x] call 0x140001131
 0x140001544 => jump=0x140001930
EOF
RUN

