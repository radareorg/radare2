NAME=anal.chain arm64 bl through a b chain
FILE=malloc://0x100
CMDS=<<EOF
e asm.arch=arm
e asm.bits=64
wx 04000094c0035fd6 @ 0
wx 04000014 @ 0x10
wx 02000014 @ 0x20
wx 02000014 @ 0x28
wx 200080d2c0035fd6 @ 0x30
f sym.target @ 0x30
aa
pi 1 @ 0
ah. @ 0
axt @ sym.target
axt @ 0x10
afl
EOF
EXPECT=<<EOF
bl sym.target
 0x00000000 => jump=0x00000030
fcn.00000000 0x0 [CALL:--x] bl 0x10
0x00000000    1      8 fcn.00000000
0x00000030    1      8 sym.target
EOF
RUN

