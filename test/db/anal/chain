NAME=anal.chain arm64 calls share a chain of named thunks
FILE=malloc://0x100
CMDS=<<EOF
e asm.arch=arm
e asm.bits=64
wx 0400009403000094c0035fd6 @ 0
wx 04000014 @ 0x10
wx 02000014 @ 0x20
wx 02000014 @ 0x28
wx 200080d2c0035fd6 @ 0x30
f sym.target @ 0x30
aa
pi 2 @ 0
ah. @ 0
axt @ sym.target
axt @ 0x10
afl
afl,attrs/str/T,addr/cols/attrs/name
afbj @ 0x10~{[0].jump}
EOF
EXPECT=<<EOF
bl sym.target
bl sym.target
 0x00000000 => jump=0x00000030
fcn.00000000 0x0 [CALL:--x] bl 0x10
fcn.00000000 0x4 [CALL:--x] bl 0x10
j.sym.target_28 0x28 [CODE:--x] b 0x30
fcn.00000000 0x0 [CALL:--x] bl 0x10
fcn.00000000 0x4 [CALL:--x] bl 0x10
0x00000010    1      4 j.sym.target
0x00000020    1      4 j.sym.target_20
0x00000028    1      4 j.sym.target_28
0x00000000    1     12 fcn.00000000
0x00000030    1      8 sym.target
addr       attrs name
---------------------
0x00000010 TE    j.sym.target
0x00000020 TE    j.sym.target_20
0x00000028 TE    j.sym.target_28

32
EOF
RUN

