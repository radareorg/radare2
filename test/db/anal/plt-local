# Insert a store to 0x35e0 after the r11 slot load, moving the call and following
# jump forward by 7 bytes. The shared thunk at 0x14a0 still returns through r11.
# Only 0x35c8/0x35d0/0x35d8 have relocations; the spill has none.
NAME=x86_64 retpoline: a spill preserves the loaded slot and caller name without applying relocs
FILE=bins/elf/pltrel/x86_64-retpoline.so
ARGS=-e bin.relocs.apply=false -e io.cache=true
CMDS=<<EOF
wx 48890522210000e8ddffffffe9caffffff @ 0x14b7
ao 2 @ 0x14b0~opcode,ptr,direction
iR~add2,mul2,sub2
aa
f~sym.plt.
pi 1 @ 0x144b
EOF
EXPECT=<<EOF
opcode: mov r11, qword [rip + 0x2111]
ptr: 0x000035c8
refptr: 8
direction: read
opcode: mov qword [rip + 0x2122], rax
ptr: 0x000035e0
refptr: 8
direction: write
0x000035c8 0x000005c8 SET_64 7     add2
0x000035d0 0x000005d0 SET_64 7     mul2
0x000035d8 0x000005d8 SET_64 7     sub2
0x000014b0 24 sym.plt.add2
0x000014d0 17 sym.plt.mul2
0x000014f0 17 sym.plt.sub2
call sym.plt.add2
EOF
RUN

