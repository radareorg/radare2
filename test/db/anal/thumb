NAME=arm32 convention resolves r0 to r3 in thumb mode
FILE=malloc://64
ARGS=-a arm -e asm.bits=16
CMDS=<<EOF
wx 40188018c0187047
af
afc arm32
afva
afv
EOF
EXPECT=<<EOF
arg int32_t arg1 @ r0
arg int32_t arg2 @ r1
arg int32_t arg3 @ r2
arg int32_t arg4 @ r3
EOF
RUN

NAME=Thumb register arguments use the register width rather than instruction bits
FILE=malloc://128
ARGS=-a arm -b 16
CMDS=<<EOF
wx 00687047
af direct
afvr
wx 00687047 @64
af callee @64
wx 00f01ef87047
af-@0
af forwarded @0
afvr @0
EOF
EXPECT=<<EOF
arg int32_t arg1 @ r0
arg int32_t arg1 @ r0
EOF
RUN

NAME=Thumb address-taken stack locals use ABI width and keep explicit access widths
FILE=malloc://64
ARGS=-a arm -b 16
CMDS=<<EOF
wx 82b001a802b07047
af
afvs
af-
wx 82b09df8040002b07047
af
afvs
af-
wx 82b0bdf8040002b07047
af
afvs
EOF
EXPECT=<<EOF
var int32_t var_4h @ sp+0x4
var int8_t var_4h @ sp+0x4
var int16_t var_4h @ sp+0x4
EOF
RUN

