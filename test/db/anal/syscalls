EXPECT=<<EOF
[{"name":"socket","swi":4000,"num":4183,"args":3,"sargs":"ixx domain type protocol"}]
[{"name":"connect","swi":4000,"num":4170,"args":3,"sargs":"ipi fd addr addrlen"}]
0x1072
0x1062
0x1063
0x1039
0x1077
0x107c
0x107e
0x10bb
0x1096
EOF
EXPECT_ERR=
RUN

NAME=Linux syscall clobbers differ from C caller-saved registers
FILE=-
CMDS=<<EOF
-a x86
-b 64
-e asm.os=linux
tcck~cc.amd64syscall.clobber
-a mips
-b 32
tcck~cc.o32syscall.clobber
tcck~cc.o32syscall.error
EOF
EXPECT=<<EOF
cc.amd64syscall.clobber=rax,rcx,r11
cc.o32syscall.clobber=v0,v1,a3
cc.o32syscall.error=a3
EOF
EXPECT_ERR=
RUN
