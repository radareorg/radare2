NAME=BPF split 64-bit immediates and fifth ABI argument
FILE=malloc://32
ARGS=-a bpf -b 64
CMDS=<<EOF
wx 1801000088776655000000004433221118090000000000000000000001000000
ao 2~val:,esil:
drp~^=A4
EOF
EXPECT=<<EOF
val: 0x1122334455667788
esil: 1234605616436508552,r1,=
val: 0x100000000
esil: 4294967296,r9,=
=A4    r5
EOF
RUN

