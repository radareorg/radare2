NAME=aar scans the range tail and preserves instruction alignment across chunks
FILE=-
ARGS=-a x86 -b 64
CMDS=<<EOF
o malloc://128 0x20000 rw
o malloc://16390 0 rwx
e asm.arch=x86
e asm.bits=64
wx 488b042500000200 @ 0
wx 488b042500000200 @ 0x3ffe
aar 8 @ 0
ax*
aar 16390 @ 0
ax*
ax-*
aar 7 @ 0x3ffe
ax~0x20000~?
EOF
EXPECT=<<EOF
axd 0x20000 0x0
axd 0x20000 0x0
axd 0x20000 0x3ffe
0
EOF
RUN

