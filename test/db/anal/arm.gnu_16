NAME=arm16 swift cc, default stays arm16
FILE=malloc://64
ARGS=-a arm -b 16
CMDS=<<EOF
e anal.cc
afcl
k anal/cc/cc.swift.self
k anal/cc/cc.swift.error
k anal/cc/cc.swift.clobber
EOF
EXPECT=<<EOF
arm16
arm16
arm32
reg
swift
sl
r8
r0,r1,r2,r3,r8,r12,lr,d0,d1,d2,d3,d4,d5,d6,d7,d16,d17,d18,d19,d20,d21,d22,d23,d24,d25,d26,d27,d28,d29,d30,d31
EOF
RUN

NAME=arm16 swift cc, explicit selection with afcr and preserve
FILE=malloc://64
ARGS=-a arm -b 16
CMDS=<<EOF
af
afc swift
afc
afcr
k anal/cc/cc.swift.preserve
EOF
EXPECT=<<EOF
swift
cc.swift.ret0: r0
cc.swift.arg0: r0
cc.swift.arg1: r1
cc.swift.arg2: r2
cc.swift.arg3: r3
cc.swift.self: sl
cc.swift.error: r8
r4,r5,r6,r7,r9,r10,r11,sp,d8,d9,d10,d11,d12,d13,d14,d15
EOF
RUN
