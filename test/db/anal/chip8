NAME=chip8 pseudo with long flag names and many words
FILE=malloc://32
ARGS=-a chip8 -m 0x100
CMDS=<<EOF
wx 2200
f sym.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA @ 0x200
ao~pseudo
wx 1200
ao~pseudo
e asm.flags.real=true
fN sym.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12
wx 2200
ao~disasm
e asm.flags.real=false
ahd call AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
e asm.pseudo=true
e asm.bytes=false
e scr.color=0
pd 1~call?
?e done
EOF
EXPECT=<<EOF
pseudo: goto sym.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
disasm: call w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12
1
done
EOF
RUN
