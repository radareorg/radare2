NAME=s1c88 function analysis
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx 0234f5fdf003f800f8
af
pdf
?e --
afl
EOF
EXPECT=<<EOF
/ 7: fcn.00000100 ();
|       .-> 0x00000100      0234           add a, 0x34
|       `=< 0x00000102      f5fd           djr nz, fcn.00000100
|           0x00000104      f003           cars fcn.00000108
\           0x00000106      f8             ret
--
0x00000100    2      7 fcn.00000100
0x00000108    1      1 fcn.00000108
EOF
RUN
