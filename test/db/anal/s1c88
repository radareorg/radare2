NAME=s1c88 pseudo syntax
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
e asm.pseudo=true
s 0x100
wx 0234e708f8f334120a34
pi 5
EOF
EXPECT=<<EOF
a += 0x34
if (nz) goto 0x00010b
return
goto 0x00133b
a += 0x34 + c
EOF
RUN

