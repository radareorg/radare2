CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx e708f5fcec0010
ao 3~address:,type:,jump:,fail:
EOF
EXPECT=<<EOF
address: 0x100
type: cjmp
jump: 0x00000109
fail: 0x00000102
address: 0x102
type: cjmp
jump: 0x000000ff
fail: 0x00000104
address: 0x104
type: cjmp
jump: 0x00001106
fail: 0x00000107
EOF
RUN

