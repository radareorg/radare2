NAME=s1c88 conditional branch targets
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx e708f5fcec0010
ao 3~address:,type:,jump:,fail:
EOF
EXPECT=<<EOF
address: 0x100
type: cjmp
jump: 0x00000109
fail: 0x00000102
address: 0x102
type: cjmp
jump: 0x000000ff
fail: 0x00000104
address: 0x104
type: cjmp
jump: 0x00001106
fail: 0x00000107
EOF
RUN

NAME=s1c88 relative branches wrap inside the code bank
FILE=malloc://0x130000
CMDS=<<EOF
e asm.arch=s1c88
s 0x12fffe
wx f102
ao 1~jump:
EOF
EXPECT=<<EOF
jump: 0x00120001
EOF
RUN

NAME=s1c88 op types
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx 0234121623d83412fb3412f8f9f4f534
pi 9
?e --
ao 9~type:
EOF
EXPECT=<<EOF
add a, 0x34
sub a, 0x16
and a, [hl]
and [br+0x34], 0x12
call [0x1234]
ret
rete
jp hl
djr nz, 0x000143
--
type: add
type: sub
type: and
type: and
type: icall
type: ret
type: ret
type: rjmp
type: cjmp
EOF
RUN

NAME=s1c88 invalid opcodes are one byte long
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx fece6600
pd 3
?e --
ao 1~size:,type:
EOF
EXPECT=<<EOF
            0x00000100      fe             invalid
            0x00000101      ce             invalid
            0x00000102      66             ld [ix], [ix]
--
size: 1
type: ill
EOF
RUN

NAME=s1c88 undocumented prefixed opcodes are rejected
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx cf10cf00ce7434
pd 4
EOF
EXPECT=<<EOF
            0x00000100      cf             invalid
            0x00000101      10             sub a, a
            0x00000102      cf00           add ba, ba
            0x00000104      ce             invalid
EOF
RUN

