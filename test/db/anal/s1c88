NAME=s1c88 pseudo syntax
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
e asm.pseudo=true
s 0x100
wx 0234e708f8f334120a34ced8ced9ce90ce94ce98ce9c
pi 11
EOF
EXPECT=<<EOF
a += 0x34
if (nz) goto 0x00010b
return
goto 0x00133b
a += 0x34 + c
hl = l * a
(l, h) = divmod (hl, a)
a = rotate_left_carry (a, 1)
a = rotate_left (a, 1)
a = rotate_right_carry (a, 1)
a = rotate_right (a, 1)
EOF
RUN

NAME=s1c88 opcode descriptions
FILE=malloc://0x100
CMDS=<<EOF
e asm.arch=s1c88
aod jrs
aod djr
aod pack
aod upck
aod slp
aod rl
aod rlc
aod rr
aod rrc
EOF
EXPECT=<<EOF
jump to short relative address, optional condition
decrement B and jump to short relative address if B is not zero
replace A's high nibble with B's low nibble
replace B's low nibble with A's high nibble
go into sleep mode (exit with outside interrupt)
rotate left one bit, C takes bit 7, bit 0 takes C
rotate left one bit, bit 7 gives its value to C and bit 0
rotate right one bit, C takes bit 0, bit 7 takes C
rotate right one bit, bit 0 gives its value to C and bit 7
EOF
RUN

NAME=s1c88 function analysis
FILE=malloc://0x1000
CMDS=<<EOF
e asm.arch=s1c88
s 0x100
wx 0234f5fdf003f800f8
af
pdf
?e --
afl
EOF
EXPECT=<<EOF
/ 7: fcn.00000100 ();
|       .-> 0x00000100      0234           add a, 0x34
|       `=< 0x00000102      f5fd           djr nz, fcn.00000100
|           0x00000104      f003           cars fcn.00000108
\           0x00000106      f8             ret
--
0x00000100    2      7 fcn.00000100
0x00000108    1      1 fcn.00000108
EOF
RUN
