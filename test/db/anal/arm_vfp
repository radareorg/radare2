ARGS=-a arm -b 32
CMDS=<<EOF
wx 000a90ed010ad0ed601a30ee201a70ee202a20ee202ac0ee600ab4ee10faf1ee400ab5ee101af1ee021a80ed040b90ed061b90ed012b30ee1eff2fe1
wx 0000c03f00000040 @0x100
aei
ar r0=0x100
ar pc=0
6aes
ar s2
ar s3
ar s4
ar s5
EOF
EXPECT=<<EOF
0xbf000000
0x40600000
0x40400000
0x3f400000
EOF
