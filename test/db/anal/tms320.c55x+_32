NAME=C55x+ rejects reserved Smem modes before wrapping operands
FILE=-
CMDS=<<EOF
e asm.arch=tms320
e asm.cpu=c55x+
pi 1 @x:624240
pi 1 @x:625240
pi 1 @x:626240
pi 1 @x:62f240
pi 1 @x:25625240
pi 1 @x:26625240
pi 1 @x:60f240
pi 1 @x:b0f2405678
pi 1 @x:620280
EOF
EXPECT=<<EOF
invalid
invalid
invalid
invalid
invalid
invalid
invalid
invalid
amar *ar2
EOF
RUN

