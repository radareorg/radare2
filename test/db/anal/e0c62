NAME=E0C62 branch targets use the current page
FILE=malloc://0x400
CMDS=<<EOF2
e log.level=0
e asm.arch=e0c62
e asm.bits=16
s 0x210
wx 1000100610051004
ao 4~type:,jump:,fail:
EOF2
EXPECT=<<EOF2
type: jmp
jump: 0x00000220
type: cjmp
jump: 0x00000220
fail: 0x00000214
type: call
jump: 0x00000020
fail: 0x00000216
type: call
jump: 0x00000220
fail: 0x00000218
EOF2
RUN

