NAME=E0C62 fail address wraps within the bank
FILE=malloc://0x4000
CMDS=<<EOF2
e log.level=0
e asm.arch=e0c62
e asm.bits=16
wx 0002 @ 0x1ffe
wx 0004 @ 0x3ffe
ao 1 @ 0x1ffe~fail:
ao 1 @ 0x3ffe~fail:
EOF2
EXPECT=<<EOF2
fail: 0x00000000
fail: 0x00002000
EOF2
RUN
