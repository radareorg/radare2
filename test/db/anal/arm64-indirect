ARGS=-a arm -b 64
CMDS=<<EOF
aaaa
afij @ 0x100023174~{0.noreturn}
abj @ 0x1000231a4~{0.size}
afij @ 0x100022ae0~{0.realsz}
afij @ 0x100022ae0~{0.ninstrs}
