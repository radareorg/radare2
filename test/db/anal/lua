NAME=lua: loadkx reads its extra argument only when it is there
FILE=malloc://8
CMDS=<<EOF
e asm.arch=lua
wx 020000002e000000
b 6
ao 1~size
b 8
ao 1~size
EOF
EXPECT=<<EOF
size: 4
size: 8
EOF
RUN

NAME=lua: instruction shorter than 4 bytes
FILE=malloc://8
CMDS=<<EOF
e asm.arch=lua
wx 03
b 1
pi 1
ao 1~type
EOF
EXPECT=<<EOF
truncated
type: ill
EOF
RUN

NAME=lua: jumps use the next PC and have no fallthrough
FILE=malloc://64
ARGS=-a lua
CMDS=<<EOF
wa jmp 0 2
s 0x10
wa jmp 1 -3
ao~type,jump,fail
s 0
ao~type,jump,fail
wa forprep 0 2
ao~type,jump,fail
wa forloop 0 -1
ao~type,jump,fail
wa tforloop 0 -1
ao~type,jump,fail
EOF
EXPECT=<<EOF
type: jmp
jump: 0x00000008
type: jmp
jump: 0x0000000c
type: jmp
jump: 0x0000000c
type: cjmp
jump: 0x00000000
fail: 0x00000004
type: cjmp
jump: 0x00000000
fail: 0x00000004
EOF
RUN

NAME=lua: loadbool skips only for nonzero C and testset branches
FILE=malloc://64
ARGS=-a lua
CMDS=<<EOF
wa loadbool 0 1 0
ao~type,jump,fail
wa loadbool 0 0 1
ao~type,jump,fail
wa testset 0 1 0
ao~type,jump,fail
EOF
EXPECT=<<EOF
type: mov
type: jmp
jump: 0x00000008
type: cjmp
jump: 0x00000008
fail: 0x00000004
EOF
RUN

NAME=lua: tailcall ends the function without a native stack pop
FILE=malloc://64
ARGS=-a lua
CMDS=<<EOF
wa tailcall 0 2 0
wa return 0 1 @ 4
af
aflj~{[0].size}
ao~type,stack
EOF
EXPECT=<<EOF
4
type: ret
type2: 0x10000004
EOF
RUN

NAME=lua: analyze byte-aligned code from a compiled 5.3 chunk
FILE=hex://1b4c7561530019930d0a1a0a04080408087856000000000000000000000028774001000000000000000000000102090000002d000001200040001e8000804d404000660000011e4000804e40400066000001260080000200000013040000000000000013010000000000000001000000010000000000000000000000000000000000
