NAME=lua: loadkx reads its extra argument only when it is there
FILE=malloc://8
CMDS=<<EOF
e asm.arch=lua
wx 020000002e000000
b 6
ao 1~size
b 8
ao 1~size
EOF
EXPECT=<<EOF
size: 4
size: 8
EOF
RUN

