type: jmp
jump: 0xfffffffffffffffc
size: 4
type: cjmp
jump: 0x00000010
fail: 0x00000004
size: 4
type: cjmp
jump: 0xfffffffffffffffc
fail: 0x00000004
size: 4
type: jmp
jump: 0x0000000c
size: 4
type: cjmp
jump: 0xfffffffffffffffc
fail: 0x00000004
size: 4
type: cjmp
jump: 0x00000008
fail: 0x00000004
type: ret
type: ret
type: ret
type2: 0x10000004
size: 8
addi 0 1 -2 ; mmbini 1 2 7 0
size: 4
size: 4
size: 8
newtable 0 0 0 0 ; extraarg 0
EOF
RUN
