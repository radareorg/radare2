NAME=Global commands preserve types and coexisting symbol flags
FILE=-
ARGS=-a x86 -b 64
CMDS=<<EOF
avgj
avg uint8_t global.byte @ 0x1000
avgj
avg. @ 0x1000
Cf. @ 0x1000
fs symbols
f obj.byte 1 @ 0x1000
avg. @ 0x1000
avg uint64_t global.byte @ 0x1000
avgj
Cf. @ 0x1000
avg- @ 0x1000
avgj
f~obj.byte
avg int * global.pointer @ 0x2000
avg int[3][2] global.array @ 0x3000
avg int const global.constant @ 0x4000
avgj
EOF
EXPECT=<<EOF
[]
[{"name":"global.byte","addr":4096,"size":1,"type":"uint8_t"}]
uint8_t
b
uint8_t
[{"name":"global.byte","addr":4096,"size":8,"type":"uint64_t"}]
q
[]
0x00001000 1 obj.byte
[{"name":"global.pointer","addr":8192,"size":8,"type":"int *"},{"name":"global.array","addr":12288,"size":24,"type":"int[3][2]"},{"name":"global.constant","addr":16384,"size":4,"type":"int const"}]
EOF
RUN

NAME=Global commands reject unknown and overflowing types without changing globals
FILE=-
ARGS=-a x86 -b 64 -e log.level=0
CMDS=<<EOF
avg uint8_t global.byte @ 0x1000
avg missing_type global.byte @ 0x1000
avg int[18446744073709551615] global.byte @ 0x1000
avgj
EOF
EXPECT=<<EOF
[{"name":"global.byte","addr":4096,"size":1,"type":"uint8_t"}]
EOF
RUN

