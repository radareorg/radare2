NAME=Global accesses infer signed integers floats doubles and pointers
FILE=-
ARGS=-a x86 -b 64
CMDS=<<EOF
o malloc://128 0x2000 rw
e asm.arch=x86
e asm.bits=64
wx 0020000000000000 @ 0x2020
wx 0fbe042500200000f30f10042508200000dd042510200000488b042520200000c3 @ 0
aar 64 @ 0
aae 33 @ 0
avgj
EOF
EXPECT=<<EOF
[{"name":"global.0x2000","addr":8192,"size":1,"type":"int8_t"},{"name":"global.0x2008","addr":8200,"size":4,"type":"float"},{"name":"global.0x2010","addr":8208,"size":8,"type":"double"},{"name":"global.0x2020","addr":8224,"size":8,"type":"void *"}]
EOF
RUN

