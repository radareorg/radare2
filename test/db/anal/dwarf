NAME=DWARF: a clone beside its origin leaves the origin's prototype alone
FILE=bins/elf/x86_64-clone-beside-origin
CMDS=<<EOF
aaa
?e link_clone=`k anal/types/fcnlink.00401000`
?e link_origin=`k anal/types/fcnlink.00401070`
afn @ 0x401000
afs @ 0x401070
EOF
EXPECT=<<EOF
link_clone=
link_origin=mix
sym.mix.constprop.0.isra.0
long int dbg.mix (S *p, long int a, long int k);
EOF
RUN

