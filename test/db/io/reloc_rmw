wox 00 @ sym.main+5!11
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
woi @ 0x08000052!14
p8 14 @ 0x08000052
EOF
EXPECT=<<EOF
e7ffffff
00000000
6f6c6c6548c35dffff48656c6c6f
EOF
RUN

