NAME=wo over an applied reloc transforms the file and the view on their own
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
wox 00 @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
wow @ sym.main+5!4
p8 4 @ sym.main+5 @e:io.overlay=false
wox ff @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
wox ff @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
woa 7f @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
wos 7f @ sym.main+5!4
wo4 @ sym.main+3!8
p8 8 @ sym.main+3
wo4 @ sym.main+3!8
p8 8 @ sym.main+3
p8 8 @ sym.main+3 @e:io.overlay=false
EOF
EXPECT=<<EOF
e7ffffff
00000000
00000000
18000000
ffffffff
e7ffffff
00000000
667e7e7e
7f7f7f7f
ffe7e8e5c35dffff
e5e8e7ffffff5dc3
e5e8000000005dc3
EOF
RUN

NAME=a fill over an applied reloc is the same in the file and the view
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
wow 90 @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
EOF
EXPECT=<<EOF
90909090
90909090
EOF
RUN

NAME=wB beside an applied reloc leaves the reloc out of the file
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
wB 0x1 @ sym.main+1
p8 8 @ sym.main+1
p8 8 @ sym.main+1 @e:io.overlay=false
EOF
EXPECT=<<EOF
4989e5e8e7ffffff
4989e5e800000000
EOF
RUN

NAME=wi over an applied reloc increments the file and the view on their own
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
wi4+ 1 @ sym.main+5
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
EOF
EXPECT=<<EOF
e8ffffff
01000000
EOF
RUN

NAME=woE and woD over an applied reloc restore the file and the view
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
woE aes-ecb 00112233445566778899aabbccddeeff @ sym.main!16
woD aes-ecb 00112233445566778899aabbccddeeff @ sym.main!16
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
EOF
EXPECT=<<EOF
e7ffffff
00000000
EOF
RUN

NAME=wo with no overlay in range is an ordinary write
FILE=malloc://16
ARGS=-w
CMDS=<<EOF
wx 00112233
wox ff @ 0!4
p8 4 @ 0
wo4 @ 0!4
p8 4 @ 0
wi1+ 1 @ 0
wB 0x10 @ 8
p8 9 @ 0
omo~?
EOF
EXPECT=<<EOF
ffeeddcc
ccddeeff
cdddeeff0000000010
0
EOF
RUN

NAME=wo without write permission changes neither the file nor the view
FILE=bins/elf/analysis/test.obj
ARGS=-e bin.relocs.apply=true
CMDS=<<EOF
wox ff @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
woA 7f @ sym.main+5!4
p8 4 @ sym.main+5
wB- 0x80 @ sym.main+5
p8 4 @ sym.main+5
EOF
EXPECT=<<EOF
e7ffffff
00000000
e7ffffff
e7ffffff
EOF
EXPECT_ERR=<<EOF
ERROR: Cannot write. Use `omp`, `io.cache` or reopen the file in rw with `oo+`
EOF
RUN

NAME=woD whose layers decode to different lengths still writes
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
w AAAAA @ sym.main
w AAAAAAA @ sym.main+9
woa 41 @ sym.main+5!4
woD base64 00 @ sym.main!16
p8 9 @ sym.main
EOF
EXPECT=<<EOF
000000000000000000
EOF
RUN

NAME=a no-op under io.cache leaves the view and adds no patch
FILE=bins/elf/analysis/test.obj
ARGS=-e bin.relocs.apply=true -e io.cache=true
CMDS=<<EOF
wox 00 @ sym.main+5!4
p8 4 @ sym.main+5
wc~?
wox ff @ sym.main+5!4
p8 4 @ sym.main+5
EOF
EXPECT=<<EOF
e7ffffff
0
18000000
EOF
RUN

NAME=one wo under io.cache is one patch
FILE=bins/elf/analysis/test.obj
ARGS=-e bin.relocs.apply=true -e io.cache=true
CMDS=<<EOF
woo 01 @ sym.main!8
wc~?
EOF
EXPECT=<<EOF
1
EOF
RUN

NAME=a no-op committed from io.cache leaves the reloc out of the file
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true -e io.cache=true
CMDS=<<EOF
wox 00 @ sym.main+5!4
wci
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
EOF
EXPECT=<<EOF
e7ffffff
00000000
EOF
RUN

NAME=a write mask masks the file and the view on their own
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
wm 0f
wox ff @ sym.main+5!4
wm-
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
EOF
EXPECT=<<EOF
08000000
0f0f0f0f
EOF
RUN

