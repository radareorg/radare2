NAME=wo over an applied reloc transforms the file and the view on their own
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
wox 00 @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
wow @ sym.main+5!4
p8 4 @ sym.main+5 @e:io.overlay=false
wox ff @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
wox ff @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
woa 7f @ sym.main+5!4
p8 4 @ sym.main+5
p8 4 @ sym.main+5 @e:io.overlay=false
wos 7f @ sym.main+5!4
wo4 @ sym.main+3!8
p8 8 @ sym.main+3
p8 8 @ sym.main+3 @e:io.overlay=false
wo4 @ sym.main+3!8
p8 8 @ sym.main+3
p8 8 @ sym.main+3 @e:io.overlay=false
woi @ sym.main+3!8
p8 8 @ sym.main+3
p8 8 @ sym.main+3 @e:io.overlay=false
EOF
EXPECT=<<EOF
e7ffffff
00000000
00000000
18000000
ffffffff
e7ffffff
00000000
667e7e7e
7f7f7f7f
ffe7e8e5c35dffff
0000e8e5c35d0000
e5e8e7ffffff5dc3
e5e8000000005dc3
c35dffffffe7e8e5
c35d00000000e8e5
EOF
RUN

