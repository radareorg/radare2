ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
s sym.main
b 16
e io.overlay=false
woE aes-ecb 00112233445566778899aabbccddeeff
p8 16
e io.overlay=true
omo~?
EOF
EXPECT=<<EOF
ca296bbe4056af15724d67ade984340d
5
EOF
RUN

NAME=io.cache with writes off reports its error once
