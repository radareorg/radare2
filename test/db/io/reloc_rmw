NAME=a transform over a write-only map adds no overlay
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
omo~?
wox ff @ 0x08000055!0x1e
omo~?
EOF
EXPECT=<<EOF
5
5
EOF
RUN

NAME=a write mask under io.cache keeps its phase across changed runs
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true -e io.cache=true
CMDS=<<EOF
wm 00ff
woo 01 @ sym.main+1!8
wm-
p8 8 @ sym.main+1
