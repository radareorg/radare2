NAME=a read-only map on top of a block keeps showing its bytes
FILE=slurp://bins/elf/analysis/test.obj
ARGS=-w -e bin.relocs.apply=true
CMDS=<<EOF
om 3 0x08000057 2 0x57 r--
wox ff @ 0x08000055!4
p8 4 @ 0x08000055
EOF
