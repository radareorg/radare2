NAME=Panels cache arbitrary commands with empty output
FILE=-
ENV=XDG_DATA_HOME=.tmp/panels-custom
CMDS=<<EOF
mkdir -p .tmp/panels-custom/radare2/r2panels
?e '{"Title":"custom","Cmd":"f hits=hits+1","x":0,"y":2,"w":80,"h":20,"Cache":true}' > .tmp/panels-custom/radare2/r2panels/test
e scr.interactive=true
e scr.wheel=false
f hits=0
v test
<jjjq
v @e:scr.interactive=true > /dev/null
?vi hits
rm -r .tmp/panels-custom
EOF
EXPECT=<<EOF
1
EOF
RUN

