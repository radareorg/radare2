NAME=Raw strings preserve accepted escapes with nofp
FILE=-
CMDS=<<EOF
e bin.str.nofp=true
wx 48656c6c6f09776f726c640a706174685c6e616d6500
izzj
EOF
EXPECT=<<EOF
[{"vaddr":0,"paddr":0,"ordinal":0,"size":22,"length":21,"section":"","type":"ascii","string":"Hello\\tworld\\npath\\\\name"}]
EOF
RUN

