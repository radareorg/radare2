# merged: idp bin state bug (#9441)
NAME=idp flags
FILE=bins/pdb/SimplePDB.exe
CMDS=<<EOF
idp bins/pdb/SimplePDB.pdb
fi 1 @ 0x00401000
fi 1 @ 0x00401010
?e --
e asm.bits
idpi bins/pdb/SimplePDB.pdb~SomeCoolFunction
e asm.bits
EOF
EXPECT=<<EOF
0x00401000 4096 section..text
0x00401000 13 pdb.void___cdecl_SomeCoolFunction_void_
0x00401010 8 pdb._main
--
32
0x00401000  2  .text  void __cdecl SomeCoolFunction(void)
32
EOF
RUN

