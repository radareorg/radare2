0.reg.read.rsp=0x1080
0.reg.write.rsp=0x1078
0.reg.read.rip=0x6
0.reg.read.rsp=0x1078
0.mem.read.0x1078=0000000000000000
0.mem.write.0x1078=0600000000000000
0.reg.write.rip=0x6
EOF
RUN

NAME=ESIL trace with ds records a single step
FILE=malloc://4096
ARGS=-a x86 -b 64
CMDS=<<EOF
e io.cache=true
wx 0501000000
s 0
aei
aeim
aeip
aets+
ds
?e after_one_ds_eax=`dr eax`
aets-
EOF
EXPECT=<<EOF
after_one_ds_eax=0x00000001
EOF
RUN