NAME=ESIL trace session recording at default config
FILE=malloc://4096
ARGS=-a x86 -b 64
CMDS=<<EOF
e io.cache=true
wx b801000000bb02000000
s 0
aei
aeim
aeip
aets+
aes
aes
aet
aets-
aet
EOF
EXPECT=<<EOF
0.addr=0x00000000
0.reg.write.rax=0x1
1.addr=0x00000005
1.reg.write.rbx=0x2
EOF
RUN

NAME=ESIL trace records the call executed by aes-over
FILE=malloc://4096
ARGS=-a x86 -b 64
CMDS=<<EOF
e io.cache=true
wx 90e800000000
s 1
aei
aeim 0x1000 0x100
aeip
dr rsp=0x1080
aets+
aeso
aet
aets-
