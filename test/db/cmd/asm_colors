[0mlea[32m rax[0m,[33m[33m [0m[[34m0x12345678[0m][32m[0m[0m
[0mret[0m[0m
[0mmov[32m eax[0m,[33m[33m [34m0x2a[0m[0m
[0mlea[32m rax[0m,[33m[33m [0m[[34m0x12345678[0m][32m[0m[0m
[0mret[0m[0m
[0mnop[0m
[0minvalid[0m
