ARGS=-a x86 -b 64
CMDS=<<EOF
ecd
ec mov red
ec reg green
ec num blue
e scr.color=1
e asm.flags=false
e asm.comments=false
e asm.lines=false
e asm.bytes=false
e asm.addr=false
e asm.tabs=0
wx b82a000000488d042578563412c3
e scr.color.mnemonics=false
pd 3
pi 3
pdi 3
wx 90
pia 1
wx 0f
pia 1
