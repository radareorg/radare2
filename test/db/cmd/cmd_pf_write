NAME=pf xxi=123
FILE=-
CMDS=<<EOF
pf foo=xxi foo bar cow
pf.foo
pf.foo.foo
.pf.foo.foo=123
pf.foo.foo
pf.foo
EOF
EXPECT=<<EOF
 foo : 0x00000000 = 0x00000000
 bar : 0x00000004 = 0x00000000
 cow : 0x00000008 = 0
 foo : 0x00000000 = 0x00000000
 foo : 0x00000000 = 0x0000007b
 foo : 0x00000000 = 0x0000007b
 bar : 0x00000004 = 0x00000000
 cow : 0x00000008 = 0
EOF
RUN

NAME=pf xxi.cow=123
FILE=-
CMDS=<<EOF
pf foo=[2]xxi foo bar cow
pf.foo.cow
.pf.foo.cow=123
pf.foo.cow
EOF
EXPECT=<<EOF
 cow : 0x0000000c = 0
 cow : 0x0000000c = 123
EOF
RUN

NAME=pf array with one write
FILE=-
CMDS=<<EOF
pf foo=[3]x foo
.pf.foo.foo=1
pf.foo
EOF
EXPECT=<<EOF
 foo : 0x00000000 = [ 0x00000001, 0x00000000, 0x00000000 ]
EOF
RUN

NAME=pf array not in meta
FILE=-
CMDS=<<EOF
pf foo=[3]x foo
.pf.foo.foo=1
.pf*.foo
e asm.lines=0
pd 1~?dword
pd 1~?foo
EOF
EXPECT=<<EOF
0
1
EOF
RUN

NAME=pf xxd print happy
FILE=-
CMDS=<<EOF
pf foo=xxd foo bar cow
w hello happy world
e asm.lines=0
.pf*.foo
pd 3
EOF
EXPECT=<<EOF
;-- foo:
0x00000000      .dword 0x6c6c6568
;-- bar:
0x00000004      .dword 0x6168206f
;-- cow:
0x00000008      .dword 0x20797070
EOF
RUN

NAME=pf xxd print
FILE=-
CMDS=<<EOF
pf foo=[2]xxd foo bar cow
w hello happy world
e asm.lines=0
e asm.flags.inbytes=0
.pf*.foo
pd 3
EOF
EXPECT=<<EOF
;-- foo:
0x00000000      .qword 0x6168206f6c6c6568
;-- bar:
0x00000008      .dword 0x20797070
;-- cow:
0x0000000c      .dword 0x6c726f77
EOF
RUN

NAME=pf field set writes only the field, pf* only prints it
FILE=malloc://32
CMDS=<<EOF
wx 41424344 @ 0
wx 99 @ 8
om 3 8 1 8 -w- hidden
pf.x xx a b
pf*.x.a=1 @ 0
p8 12 @ 0 @e:io.va=false
pf.x.a=1 @ 0
p8 12 @ 0 @e:io.va=false
pf.y [4]XT c d
pf.y.c=11 @ 0x10
pf*.y.c=11 @ 0x10
.pf.y.c=11 @ 0x10
pf.y.d=1 @ 0x10
p8 16 @ 0x10
EOF
EXPECT=<<EOF
wv4 1 @ 0x00000000
414243440000000099000000
010000000000000099000000
00000000000000000000000000000000
EOF
EXPECT_ERR=<<EOF
ERROR: pf X not yet implemented
ERROR: pf X not yet implemented
ERROR: pf X not yet implemented
ERROR: pf T not yet implemented
EOF
RUN
