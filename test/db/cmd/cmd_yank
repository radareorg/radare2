NAME=file yank reads its own descriptor without changing IO state
FILE=malloc://16
CMDS=<<EOF
wx 11223344
s 8
e file.loadalign=0
yfa hex://aabbccdd
y8
e io.va=false
yf 2 1 hex://aabbccdd
y8
e io.autofd=false
e file.loadalign=0x1000
e io.va=true
yf 2 1 hex://aabbccdd
y8
yfa hex://aabbccdd
y8
oqq
oq~?
om~?
s
p8 4 @ 0
EOF
EXPECT=<<EOF
aabbccdd
bbcc
bbcc
aabbccdd
3
1
1
0x8
11223344
EOF
RUN

