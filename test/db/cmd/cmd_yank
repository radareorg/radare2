CMDS=<<EOF
ywx 1122
yf 2 3 hex://aabbccdd
yf 1 4 hex://aabbccdd
yf 1 0xffffffffffffffff hex://aabbccdd
yf 0x80000000 0 hex://aabbccdd
y8
oq~?
om~?
EOF
EXPECT=<<EOF
1122
1
1
EOF
