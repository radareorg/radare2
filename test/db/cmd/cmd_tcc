NAME=tcc: floating return register per convention
FILE=-
ARGS=-a arm -b 64
CMDS=<<EOF
k anal/cc/cc.arm64.fpret0
k anal/cc/cc.swift.fpret0
e asm.arch=x86
e asm.bits=64
k anal/cc/cc.amd64.fpret0
k anal/cc/cc.swift.fpret0
k anal/cc/cc.ms.fpret0
EOF
EXPECT=<<EOF
{d0,s0,v0,q0}
{d0,s0,v0,q0}
xmm0
xmm0
xmm0
EOF
RUN

NAME=tcc: redefining a convention clears its floating return
FILE=-
ARGS=-a x86 -b 64
CMDS=<<EOF
k anal/cc/cc.amd64.fpret0
tcc rax amd64 (rdi, rsi);
k anal/cc/cc.amd64.fpret0
k anal/cc/cc.amd64.ret0
EOF
EXPECT=<<EOF
xmm0
rax
EOF
RUN

NAME=tcc: deleting a convention clears its floating return
FILE=-
ARGS=-a x86 -b 64
CMDS=<<EOF
k anal/cc/cc.amd64.fpret0
tcc-amd64
k anal/cc/cc.amd64.fpret0
k anal/cc/cc.amd64.ret0
EOF
EXPECT=<<EOF
xmm0
EOF
RUN

NAME=tcc: the export restores the floating return
FILE=-
ARGS=-a x86 -b 64
CMDS=<<EOF
k anal/cc/cc.amd64.fpret0
tcc* > .fpret-roundtrip.r2
. .fpret-roundtrip.r2
k anal/cc/cc.amd64.fpret0
rm .fpret-roundtrip.r2
EOF
EXPECT=<<EOF
xmm0
xmm0
EOF
RUN

