NAME=panels refresh reruns a cached command once without changing cache mode
FILE=-
CMDS=<<EOF
"$capture=v @e:scr.interactive=true > $panel"
e scr.wheel=false
e scr.cols=100
e scr.rows=30
f counter=0
"$probe=f counter=counter+1;?v counter"
<e$probe\n=j qQ
v @e:scr.interactive=true > /dev/null
f before=counter
<Q
v @e:scr.interactive=true > /dev/null
?v counter-before
<=jj Q
$capture > /dev/null
?v counter-before
cat $panel~Cache (on)~?
f before=counter
<Q
v @e:scr.interactive=true > /dev/null
?v counter-before
<=j qQ
v @e:scr.interactive=true > /dev/null
f before=counter
<=jj Q
$capture > /dev/null
"?v counter>before"
cat $panel~Cache (off)~?
EOF
EXPECT=<<EOF
0x0
0x1
1
0x0
0x1
1
EOF
RUN

