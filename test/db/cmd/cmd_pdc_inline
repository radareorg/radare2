    { // inline child
        { // inline leaf
                { goto inline_0x00000000_0x00000040_end; }
                { goto inline_0x00000000_0x00000040_end; }
            inline_0x00000000_0x00000040_end:;
    { // inline child
        { // inline leaf
                { goto inline_0x00000005_0x00000040_end; }
                { goto inline_0x00000005_0x00000040_end; }
            inline_0x00000005_0x00000040_end:;
EOF
RUN

