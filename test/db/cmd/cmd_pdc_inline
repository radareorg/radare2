NAME=pdc inline is opt-in and follows the function mark
FILE=malloc://256
ARGS=-a x86 -b64
CMDS=<<EOF
wx e83b00000083c002c3
wx 83c001c3 @ 0x40
af child @ 0x40
af caller @ 0
e pdc.inline
e pdc.inline=true
pdc @ 0~inline child~?
afia+ inline @ 0x40
pdc @ 0
afia- inline @ 0x40
pdc @ 0~inline child~?
EOF
EXPECT=<<EOF
false
0
// callconv: rax amd64 (rdi, rsi, rdx, rcx, r8, r9, stack);
void caller (void) {
    { // inline child
        eax += 1
    }
    eax += 2
    return eax    // rsp
}

0
EOF
RUN

NAME=pdc inline nested and repeated calls have distinct labels
