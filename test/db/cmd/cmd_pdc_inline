ARGS=-a x86 -b64 -e pdc.inline=true -e pdc.optimize=true
CMDS=<<EOF
wx bf07000000e83600000083c002c3
wx 8d4703c3 @ 0x40
af child @ 0x40
af caller @ 0
td int child(int x);
afia+ inline @ 0x40
pdc @ 0
EOF
EXPECT=<<EOF
// callconv: rax amd64 (rdi, rsi, rdx, rcx, r8, r9, stack);
void caller (void) {
    edi = 7
    { // inline child
        eax = rdi + 3 // arg1
    }
    eax += 2
    return eax    // rsp
}

EOF
RUN

