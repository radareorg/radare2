NAME=qjs HTTP respects sandbox denial
FILE=-
ARGS=-e log.level=0
CMDS=<<EOF
'js r2.cmd("e cfg.sandbox.grain=none;e cfg.sandbox=true"); for (const method of ["GET", "POST"]) { try { r2.http(method, "http://192.0.2.1/", ""); } catch (e) { console.log(e.name + ": " + e.message); } }
EOF
EXPECT=<<EOF
InternalError: HTTP request failed or denied
InternalError: HTTP request failed or denied
EOF
EXPECT_ERR=
RUN

