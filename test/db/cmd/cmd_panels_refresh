NAME=panels disassembly navigation leaves pinned commands unchanged
FILE=-
TIMEOUT=10
ARGS=-a x86 -b 64
CMDS=<<EOF
"$capture=v @e:scr.interactive=true > $panel"
"$probe=?v $$+0xabc00000"
e scr.wheel=false
e scr.cols=100
e scr.rows=30
wx 909090c3
<e$probe\n=jjj q-\tDj000000Q
$capture > /dev/null
cat $panel~0xabc00000~?
cat $panel~0xabc00001~?
EOF
EXPECT=<<EOF
1
0
EOF
RUN

