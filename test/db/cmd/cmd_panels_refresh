NAME=panels clean uncached command is reused while navigating another panel
FILE=-
TIMEOUT=10
CMDS=<<EOF
"$capture=v @e:scr.interactive=true > $panel"
"$probe=f counter=counter+1;?e PANEL_OUTPUT;?v counter"
e scr.wheel=false
e scr.cols=100
e scr.rows=30
f counter=0
<e$probe\n00000000\tjjkkQ
$capture > /dev/null
?v counter
cat $panel~PANEL_OUTPUT~?
EOF
EXPECT=<<EOF
0x2
1
EOF
RUN

