# block 4 is a level 1 node whose only pointer is block 4 itself: mounting
# must fail instead of looping forever in grub_xfs_read_block
NAME=xfs self referencing block map btree node
FILE=malloc://20480
TIMEOUT=30
CMDS=<<EOF
wx 58465342000010 @ 0x0
wx 10 @ 0x3f
wx 21 @ 0x57
wx 0c09080406 @ 0x78
wx 494e41ed0203 @ 0x1000
wx 10 @ 0x103e
wx 010001 @ 0x1065
wx 04 @ 0x1077
wx 494e81a40202 @ 0x1100
