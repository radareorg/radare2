NAME=asm.spp with an unterminated tag
FILE=malloc://64
CMDS=<<EOF
e asm.arch=x86
e asm.bits=32
e asm.spp=true
'pa nop <{this tag is never closed AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
pa nop
?e done
EOF
EXPECT=<<EOF
90
90
done
EOF
RUN

NAME=asm.spp expands a closed tag
FILE=malloc://64
CMDS=<<EOF
e asm.arch=x86
e asm.bits=32
e asm.spp=true
'pa <{set x nop}>nop
'pa <{get x}>
EOF
EXPECT=<<EOF
90
90
EOF
RUN

