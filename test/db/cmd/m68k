NAME="m68k: data alignment for empty, 68000 and 68030 cpu"
ARGS=-a m68k
FILE=malloc://16
CMDS=<<EOF
e asm.cpu=
aia~dtalign
e asm.cpu=68000
aia~dtalign
e asm.cpu=68030
aia~dtalign
EOF
EXPECT=<<EOF
dtalign 2
dtalign 2
dtalign 1
EOF
RUN

NAME="m68k: m68k filter"
CMDS=<<EOF
e asm.arch=m68k
e asm.bits=32
wx 33fc010000a10000
pi 1
f foo.bar = 0xa10000
pi 1
EOF
EXPECT=<<EOF
move.w 0x100, 0xa10000.l
move.w 0x100, foo.bar
EOF
RUN

NAME="m68k: m68k filter2"
CMDS=<<EOF
e asm.arch=m68k
e asm.bits=32
wx 33fc010000a10000
pi 1
f foo.bar = 0x100
pi 1
EOF
EXPECT=<<EOF
move.w 0x100, 0xa10000.l
move.w foo.bar, 0xa10000.l
EOF
RUN