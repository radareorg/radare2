NAME=r+ keeps the end of the file
FILE=malloc://8
CMDS=<<EOF
wx 6162636465666768
r+2 @ 3
r
p8 10 @e:io.va=0
r-2 @ 3
r
p8 8
EOF
EXPECT=<<EOF
10
61626364656465666768
8
6162636465666768
EOF
RUN

