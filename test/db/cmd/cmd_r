CMDS=<<EOF
wx 6162636465666768 @ 0x1000
r+2 @ 0x1003
r
p8 10 @ 0 @e:io.va=0
r-2 @ 0x1003
r
p8 8 @ 0 @e:io.va=0
EOF
EXPECT=<<EOF
10
61626364656465666768
8
6162636465666768
EOF
RUN

