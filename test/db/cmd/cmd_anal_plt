# readelf -r: R_X86_64_64 foo at .data+0 (slot), no symbol reloc at .data+8 (spill)
NAME=x86_64 plt stub: a store after the slot load does not replace the slot
FILE=bins/elf/x86_64-plt-dirwrite.o
ARGS=-e bin.relocs.apply=true
CMDS=<<EOF
aa
f~sym.plt.
EOF
EXPECT=<<EOF
0x08000041 19 sym.plt.foo
EOF
RUN

