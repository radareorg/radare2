NAME=?e pi backquote color on
FILE=malloc://1024
CMDS=<<EOF
e asm.arch=x86
e asm.bits=64
wx 90
e scr.color=true
?e `pi 1`
EOF
EXPECT=<<EOF
nop
EOF
RUN

NAME=?em accepts a wide treemap
FILE=malloc://64
CMDS=<<EOF
e scr.cols=5000
e scr.rows=6
?em 1~?
EOF
EXPECT=<<EOF
3
EOF
RUN

NAME=?em accepts a tall treemap
FILE=malloc://64
CMDS=<<EOF
e scr.cols=8
e scr.rows=10000
?em 1~?
EOF
EXPECT=<<EOF
5000
EOF
RUN

NAME=?em small treemap
FILE=malloc://64
CMDS=<<EOF
e scr.cols=6
e scr.rows=6
?em 1
EOF
EXPECT=<<EOF
+----+
|1   |
+----+

EOF
RUN

NAME=?ep rejects oversized pie chart size without crashing
FILE=malloc://64
CMDS=<<EOF
e scr.color=0
e hex.cols=65536
?ep 10 20
e hex.cols=46341
?ep 10 20
?e survived
EOF
EXPECT=<<EOF
survived
EOF
RUN
