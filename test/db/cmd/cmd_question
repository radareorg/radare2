NAME=?e pi backquote color on
FILE=malloc://1024
CMDS=<<EOF
e asm.arch=x86
e asm.bits=64
wx 90
e scr.color=true
?e `pi 1`
EOF
EXPECT=<<EOF
nop
EOF
RUN

NAME=?em accepts a wide treemap
FILE=malloc://64
CMDS=<<EOF
e scr.cols=5000
e scr.rows=6
?em 1~?
EOF
EXPECT=<<EOF
3
EOF
RUN

