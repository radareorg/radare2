NAME=mc missing arguments and malformed commands
FILE=-
CMDS=<<EOF2
m /tmp tmp
mc
?v $?
mcx /tmp/missing
?v $?
mc /tmp/missing
?v $?
EOF2
EXPECT=<<EOF2
0x1
0x1
0x1
EOF2
EXPECT_ERR=<<EOF2
ERROR: Usage: mc [filename]
ERROR: Usage: mc [filename]
ERROR: Cannot open /tmp/missing
EOF2
RUN

NAME=mc whitespace, empty files and return code reset
FILE=-
CMDS=<<EOF2
m /tmp tmp
mw /tmp/data hello
mw /tmp/empty
?=1
mc   /tmp/data
?v $?
?=1
mc	/tmp/data
?v $?
?=1
mc /tmp/empty
?v $?
EOF2
EXPECT=<<EOF2
hello
0x0
hello
0x0

0x0
EOF2
EXPECT_ERR=
RUN

NAME=mc and mg help reset return code
FILE=-
CMDS=<<EOF2
?=1
mc?
?v $?
?=1
mg?
?v $?
EOF2
