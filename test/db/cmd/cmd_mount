NAME=mc and mg reject truncated FAT files without hanging
FILE=bins/fs/fat.img
TIMEOUT=10
CMDS=<<EOF2
e log.level=0
e io.cache=true
# Increase README.md's size beyond its allocated cluster chain.
wx 00001000 @ 0x71c
mkdir r2r-mg-truncated
cd r2r-mg-truncated
mc /root/README.md || echo read-failed
mg /root/README.md || echo dump-failed
rm README.md
cd ..
rm r2r-mg-truncated
EOF2
EXPECT=<<EOF2
read-failed
dump-failed
EOF2
EXPECT_ERR=
RUN

NAME=mount context quoted paths, data and escaped spaces
FILE=-
CMDS=<<EOF2
m "/tmp space" tmp
md+ "/tmp space/dir name"
mw "/tmp space/dir name/a b" "a  b"
mc /tmp\ space/dir\ name/a\ b
mw '/tmp space/empty file' ""
mc "/tmp space/empty file"
mdq "/tmp space"
mdj "/tmp space/dir name"
m- "/tmp space"
m
EOF2
EXPECT=<<EOF2
a  b

dir name/
empty file
[{"type":"unknown","size":4,"name":"a b"}]
EOF2
EXPECT_ERR=
RUN

NAME=mount context quoted options and offset expression
FILE=-
CMDS=<<EOF2
m tmp "/quoted mount" "1 + 2" "label=a  b"
m
m*
m- /quoted\ mount
m /opts tmp "label=c  d"
m
m-/opts
m
EOF2
EXPECT=<<EOF2
tmp	0x3	/quoted mount	label=a  b
m /quoted\ mount tmp 0x3 label=a\ \ b
tmp	0x0	/opts	label=c  d
EOF2
EXPECT_ERR=
RUN

NAME=mount context write requires quoting multiple words
FILE=-
CMDS=<<EOF2
m /tmp tmp
mw /tmp/file original
mw /tmp/file a b || echo rejected
mc /tmp/file
mw /tmp/file "a  b  cd"
mc /tmp/file
EOF2
EXPECT=<<EOF2
rejected
original
a  b  cd
EOF2
EXPECT_ERR=<<EOF2
ERROR: Usage: mw [file] [data]
EOF2
RUN

