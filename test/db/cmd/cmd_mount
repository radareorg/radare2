NAME=mg multi-block ranges and overwrite
FILE=-
CMDS=<<EOF2
m /tmp tmp
mw /tmp/r2r-mg-range 0123456789
b 3
mg /tmp/r2r-mg-range
?v $?
cat r2r-mg-range
?e
mg /tmp/r2r-mg-range 1+1 5
?v $?
cat r2r-mg-range
?e
mg /tmp/r2r-mg-range 8 100
?v $?
cat r2r-mg-range
?e
