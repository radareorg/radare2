e io.cache=true
# Increase README.md's size beyond its allocated cluster chain.
wx 00001000 @ 0x71c
m /tmp tmp
mw /tmp/original original
my /tmp/original
mkdir r2r-mg-truncated
cd r2r-mg-truncated
mc /root/README.md || echo read-failed
mg /root/README.md || echo dump-failed
my /root/README.md || echo yank-failed
y8
mo /root/README.md || echo open-failed
rm README.md
cd ..
rm r2r-mg-truncated
EOF2
EXPECT=<<EOF2
read-failed
dump-failed
yank-failed
6f726967696e616c
open-failed
EOF2
EXPECT_ERR=
RUN

