NAME=ext3 journal recovers committed inode and file data
FILE=gzip://bins/fs/ext-journal/ext3.img.gz
CMDS=<<EOF2
e log.level=0
m:ext2 journal /root~[0,3]
m:ext2 journal-inodej /root 100 13~{size}
m:ext2 journal-recover /root 100 13 -
EOF2
EXPECT=<<EOF2
99 committed
100 committed
101 committed
102 revoked
102 revoked
28
Deleted through the journal
EOF2
EXPECT_ERR=
RUN

