NAME=!
FILE=malloc://512
CMDS=<<EOF
?e fuck
?e yeah
!echo fuck
!echo yeah
EOF
EXPECT=<<EOF
fuck
yeah
fuck
yeah
EOF
RUN

NAME=system shell owns conditional operators
FILE=malloc://512
CMDS=<<EOF
!echo LEFT && echo RIGHT
!false || echo RECOVERED
!printf PIPE 2>/dev/null | grep PIPE
EOF
EXPECT=<<EOF
LEFT
RIGHT
RECOVERED
PIPE
EOF
RUN

NAME=system commands keep r2 preprocessing
FILE=malloc://512
CMDS=<<EOF
!!printf 'alpha\nbeta\n'~alpha
!printf '%s\n' $(!printf nested)
EOF
EXPECT=<<EOF
alpha
nested
EOF
RUN

NAME=!| grep
FILE=malloc://512
CMDS=!echo fuck|grep bob
EXPECT=<<EOF
EOF
RUN

NAME=!| sed
FILE=malloc://512
CMDS=!echo fuck|sed -e s,fuck,yeah,
EXPECT=<<EOF
yeah
EOF
RUN

NAME=?e|
FILE=malloc://512
CMDS=?e fuck|sed -e s,fuck,yeah,
EXPECT=<<EOF
yeah
EOF
RUN

NAME=p8 `?e 3`
FILE=malloc://512
CMDS=p8 `?e 3`
EXPECT=<<EOF
000000
EOF
RUN

NAME=p8 `!echo 3`
FILE=malloc://512
CMDS=p8 `!echo 3`
EXPECT=<<EOF
000000
EOF
RUN

NAME=!echo "test"
FILE=malloc://512
CMDS=<<EOF
!echo test
"!echo test"
EOF
EXPECT=<<EOF
test
test
EOF
RUN

NAME=%ENV=33 !echo "${ENV}"
FILE=malloc://512
CMDS=<<EOF
%ENV=World
!echo ${ENV}
EOF
EXPECT=<<EOF
World
EOF
RUN
