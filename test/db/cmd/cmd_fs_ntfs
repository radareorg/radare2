NAME=NTFS discovers deleted MFT filenames without directory indexes
FILE=gzip://bins/fs/ntfs-forensic/recovery.img.gz
CMDS=<<EOF2
mdxj /root
mdxj /root 0
EOF2
EXPECT=<<EOF2
[{"type":"file","size":368,"name":"inline.txt","id":66,"deleted":true,"flags":3},{"type":"file","size":18432,"name":"vanished.bin","id":65,"deleted":true,"flags":3}]
[{"type":"file","size":18432,"name":"vanished.bin","id":65,"deleted":true,"flags":3},{"type":"file","size":368,"name":"inline.txt","id":66,"deleted":true,"flags":3}]
EOF2
EXPECT_ERR=
RUN

