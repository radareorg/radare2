NAME=NTFS resolves resident and deleted disk ownership
FILE=gzip://bins/fs/ntfs-forensic/recovery.img.gz
CMDS=<<EOF2
mfo /root 0x14171
mix /root 0x167401
mfu /root orphan
mc /root/live.txt
EOF2
EXPECT=<<EOF2
/root/$MFT
/root/live.txt
/root/vanished.bin
Live NTFS file

EOF2
EXPECT_ERR=
RUN

NAME=NTFS fs.deleted salvages runs past a reused cluster while recovery keeps the prefix
FILE=gzip://bins/fs/ntfs-forensic/recovery.img.gz
CMDS=<<EOF2
e io.cache=true
# Mark the cluster at 0x167e00 allocated in $Bitmap.
woo 80 @ 0x106b67!1
e search.verbose=false
e fs.cwd=/root
mie /root 65
e search.in=fs.deleted
e search.from=0x167e00
e search.to=0x168000
/xj 5265636f766572
e search.from=0x168000
e search.to=0x168020
/xj 5265636f766572
EOF2
EXPECT=<<EOF2
0x00000000 0x00167400 2560 0x1
[]
[{"addr":1474566,"type":"hexpair","data":"5265636f766572"},{"addr":1474584,"type":"hexpair","data":"5265636f766572"}]
EOF2
EXPECT_ERR=<<EOF2
ERROR: Filesystem range enumeration: error
EOF2
RUN

NAME=NTFS lists reads and maps alternate data streams through the fork namespace
FILE=gzip://bins/fs/ntfs-forensic/recovery.img.gz
CMDS=<<EOF2
e io.cache=true
# Append resident named DATA proof to MFT 64 without changing the fixture.
wx 800000003800000000051800000028000900000028000000700072006f006f0066000000000000004c697665204144530a00000000000000ffffffff00000000 @ 0x14180
wv4 448 @ 0x14018
wv2 41 @ 0x14028
mdj /root/live.txt/..namedfork
mc /root/live.txt/..namedfork/ads:proof
mie /root/live.txt/..namedfork/ads:proof
mfo /root/live.txt/..namedfork 0x141a9
EOF2
EXPECT=<<EOF2
[{"type":"file","size":15,"name":"data","id":64,"deleted":false,"flags":0},{"type":"file","size":9,"name":"ads:proof","id":4611686018427387907,"deleted":false,"flags":0}]
Live ADS

0x00000000 0x000141a8 9 0x2
/root/live.txt/..namedfork/ads:proof
EOF2
EXPECT_ERR=
RUN

