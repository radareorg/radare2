NAME=comment spaces
FILE=--
CMDS=<<EOF
CS one
CC foo
CS two
CC bar @ 1
CC cow @ 2
CC
CS
EOF
EXPECT=<<EOF
0x00000001 CCu "bar"
0x00000002 CCu "cow"
    1 . one
    2 * two
EOF
RUN

NAME=select all meta spaces
FILE=--
CMDS=<<EOF
CS one
CC foo
CS two
CC bar @ 1
CC cow @ 2
CS *
CC
EOF
EXPECT=<<EOF
0x00000000 CCu "foo"
0x00000001 CCu "bar"
0x00000002 CCu "cow"
EOF
RUN
