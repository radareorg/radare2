NAME=afv autonames thousands of colliding stack variables in linear passes
FILE=malloc://32768
ARGS=-a x86 -b 64
TIMEOUT=15
CMDS=<<EOF
wow ff742408 @ 0!32000
wx c3 @ 32000
af
afv~?
afv~var_8h_7998 @
