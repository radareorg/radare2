hello
arg int64_t redef @ rsp+0x28
EOF
RUN

NAME=afv autonames thousands of colliding stack variables in linear passes
FILE=malloc://32768
ARGS=-a x86 -b 64
TIMEOUT=120
CMDS=<<EOF
wow ff742408 @ 0!32000
wx c3 @ 32000
af
afv~?
afv~var_8h_7998 @
EOF
EXPECT=<<EOF
8000
var int64_t var_8h_7998 @ rsp+0x10
EOF
RUN

NAME=afvn relabels the var comments even without known accesses
FILE=malloc://64
ARGS=-a x86 -b 32
CMDS=<<EOF
wx 5589e5518b4508c9c3
af
afc thiscall
afvr ecx arg1 int32_t
"Ct arg1" @ 3
"Ct int32_t arg_8h" @ 4
afvn this arg1
Ct. @ 3
Ct. @ 4
EOF
