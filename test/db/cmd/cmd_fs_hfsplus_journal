[{"type":"file","size":6,"name":"child.txt","id":13835058055282163715,"deleted":true,"flags":3}]
[{"type":"file","size":6,"name":"child.txt","id":13835058055282163719,"deleted":true,"flags":3}]
Journal resource one
Journal resource two
EOF2
EXPECT_ERR=
RUN

