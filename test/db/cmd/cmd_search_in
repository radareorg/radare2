# merged: / search io.maps with map; / search io.maps 2
NAME=/ search.in=io.maps without -m
FILE=bins//wasm/inc.wast
ARGS=-m 0x80000
CMDS=<<EOF
e search.in=io.maps
e io.va=true
/ get~[0]
?e --
e search.in=io.maps
e io.va=true
/ get~[0]
?e --
om 3 0x400000
e io.va=true
e search.in=io.maps
/ get~[0]
EOF
EXPECT=<<EOF
0x00080053
0x00080067
--
0x00080053
0x00080067
--
0x00080053
0x00080067
0x00400053
0x00400067
EOF
RUN

