CMDS=<<EOF
e pdc.optimize
EOF
EXPECT=<<EOF
true
EOF
RUN

NAME=pdc optimization can be disabled
FILE=malloc://0x2000
ARGS=-a arm -b 64 -e anal.vars=false -e pdc.optimize=true
CMDS=<<EOF
wx 080000b0089142f9c0035fd6
af
pdc~=
e pdc.optimize=false
pdc~=
EOF
