NAME=afcf preserves recovered arguments until a count is declared
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
af+ 0 custom_fatal
afb+ 0 0 10
afvr rdi status int
afcf
tk func.custom_fatal.args=0
afiq~stack:
tk func.custom_fatal.args=
tk custom_fatal=func
afcf
afs
tk func.custom_fatal.ret=void
afcf
afcfj
afiq~stack:
tk func.custom_fatal.args=0
afcf
afs
afcfj
afiq~stack:
tk func.custom_fatal.args=1
tk func.custom_fatal.arg.0=long,declared
afcf
EOF
EXPECT=<<EOF
custom_fatal (int status);
  stack: 0x00000000 (vars:0 args:1)
custom_fatal (int status);
void custom_fatal (int status);
void custom_fatal (int status);
[{"name":"custom_fatal","args":[{"name":"status","type":"int"}],"count":1}]
  stack: 0x00000000 (vars:0 args:1)
void custom_fatal ();
void custom_fatal ();
[{"name":"custom_fatal","return":"void","args":[],"count":0}]
  stack: 0x00000000 (vars:0 args:0)
void custom_fatal (long declared);
EOF
RUN

NAME=recovered signatures keep register arguments before sorted stack arguments
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
wx c3
af+ 0 fallback
afb+ 0 0 1
afvr rsi second int
afvb 16 last int
afvb 8 third int
afvr rdi first int
afcf
afs
zaf
z*~za fallback t
EOF
EXPECT=<<EOF
fallback (int first, int second, int third, int last);
void fallback (int first, int second, int third, int last);
za fallback t void fallback (int first, int second, int third, int last)
EOF
RUN

