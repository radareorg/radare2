NAME=afcf resolves short names and relocated imports
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
td int f(int value);
af+ 0 f
afb+ 0 0 10
afcf
af+ 0x10 sym.imp.f
afb+ 0x10 0x10 10
afcf @ 0x10
af+ 0x20 reloc.f
afb+ 0x20 0x20 10
afcf @ 0x20
EOF
EXPECT=<<EOF
int f (int value);
int sym.imp.f (int value);
int reloc.f (int value);
EOF
RUN

NAME=afcf distinguishes recovered arguments from an explicit prototype
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
td void fatal(void);
tk func.reloc.fatal.args=1
tk func.reloc.fatal.arg.0=int,status
af+ 0 reloc.fatal
afb+ 0 0 10
afcf
tk reloc.fatal=func
afcf
af+ 0x10 fatal
afb+ 0x10 0x10 10
afcf @ 0x10
EOF
EXPECT=<<EOF
