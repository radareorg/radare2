NAME=pifcj literal function names and unresolved calls
FILE=malloc://32
ARGS=-a x86 -b 64
CMDS=<<EOF
wx e80300000090c390c3
af
af @ 8
afn callee_%08x_%% @ 8
pifcj
afn callee_%s_%n_%5$n @ 8
pifcj
afn callee @ 8
pifcj
af- 8
pifcj
EOF
EXPECT=<<EOF
[{"dest":"callee_%08x_%%","addr":8,"at":0}]
[{"dest":"callee_%s_%n_%5$n","addr":8,"at":0}]
[{"dest":"callee","addr":8,"at":0}]
[{"dest":"0x00000008","addr":8,"at":0}]
EOF
RUN

