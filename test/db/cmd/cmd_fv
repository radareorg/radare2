[]
EMPTY
SET
0x00000010
FOUND
MISSING
INVALID
DELETED
[]
EMPTY
EOF
EXPECT_ERR=<<EOF
ERROR: No mark for this key
ERROR: Invalid visual mark key
EOF
RUN

