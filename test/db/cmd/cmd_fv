NAME=fv command return codes
FILE=-
CMDS=<<EOF
fvj && ?e EMPTY
fv a 0x10 && ?e SET
fv a && ?e FOUND
fv z || ?e MISSING
fv-0x100 || ?e INVALID
fv-a && ?e DELETED
fvj && ?e EMPTY
EOF
