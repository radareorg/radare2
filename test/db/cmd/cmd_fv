NAME=fvv descriptions and fixed width for 64-bit addresses
FILE=-
CMDS=<<EOF
f demo @ 0x10
CC comment @ 0x10
fv a 0x10
f wide @ 0xfffffffffffffffe
fv 0xff 0xfffffffffffffffe
fvv
fv
EOF
EXPECT=<<EOF
  .-----[ vmarks ]-------------------------------------------------.
  | ['a] 0x00000010  demo ; comment                                |
  | ['\xff] 0xfffffffffffffffe  wide                               |
  `----------------------------------------------------------------'
- [ma]      0x10
- [m\xff] 0xfffffffffffffffe
EOF
RUN
