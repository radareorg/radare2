NAME=fv get set and delete character and numeric keys
FILE=-
CMDS=<<EOF
fvj
fv a 0x10
?v $?
fv a
?v $?
fv 97 0x20 + 1
fv 0x61
fvj
fv-0x61
?v $?
fvj
EOF
EXPECT=<<EOF
[]
0x0
0x00000010
0x0
0x00000021
[{"ord":97,"key":"a","addr":33}]
0x0
[]
EOF
RUN

NAME=fv byte boundaries and script roundtrip
FILE=-
CMDS=<<EOF
fv 0x00 0
fv 0x01 1
fv 0xff 0xfffffffffffffffe
fv 0x00
fv 0xff
fv*
fvj
fv* > $vmarks
fv-*
fvj
.$vmarks
fv*
fv-0xff
fv-0x00
fv-0x01
fvj
EOF
EXPECT=<<EOF
0x00000000
0xfffffffffffffffe
fv 0x00 0x0
fv 0x01 0x1
fv 0xff 0xfffffffffffffffe
[{"ord":0,"addr":0},{"ord":1,"addr":1},{"ord":255,"addr":18446744073709551614}]
[]
fv 0x00 0x0
fv 0x01 0x1
fv 0xff 0xfffffffffffffffe
[]
EOF
RUN

