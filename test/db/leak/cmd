NAME=leak omb+ with an existing bank name
FILE=-
CMDS=<<EOF
e log.level=0
omb+ foo
omb+ foo
omb
EOF
EXPECT=<<EOF
* 0 default [ 1 ]
- 1 foo [ ]
EOF
RUN

