NAME=leak tcc rejected parameter list
FILE=-
CMDS=<<EOF
e log.level=0
e types.plugin=tcc
td int f(void x)
td int f(int x, 1)
?e ok
EOF
EXPECT=<<EOF
ok
<string>:1: error: parameter declared as void
<string>:1: error: ';' expected (got ")")
<string>:1: error: declaration expected
<string>:1: error: invalid type
<string>:1: error: ';' expected (got "1")
<string>:1: error: declaration expected
EOF
RUN

