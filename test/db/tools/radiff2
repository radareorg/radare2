!radiff2 -C .tmp/radiff-single-a.prj .tmp/radiff-single-b.prj
rm .tmp/radiff-single-a.prj
rm .tmp/radiff-single-b.prj
END
EXPECT=<<END
main 6 0x1000 |   MATCH  (1.000000) | 0x1000  6 main
main 6 0x1000 |   MATCH  (0.833333) | 0x2000  6 main
END
RUN

