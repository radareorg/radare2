# merged: mach0 thumb entrypoint info; mach0 non-thumb symbol on thumb bin
NAME=mach0 thumb entrypoint bits
FILE=bins/mach0/thumb-test
CMDS=<<EOF
e asm.bits
?e --
ie=~vaddr
?e --
pi 1@ sym.imp.strcmp
EOF
EXPECT=<<EOF
16
--
paddr=0x00007fa4 vaddr=0x0000bfa4 haddr=0x00000344 type=program
--
ldr pc, [reloc.strcmp]
EOF
RUN

