NAME=Fat Mach-O 32-bit CFString at slice end uses a file offset
FILE=malloc://768
ARGS=-a arm -b32 -e bin.relocs=false
CMDS=<<EOF
wx cafebabe000000010000000c00000009000001000000020000000000 @ 0
wx  @ 0x100
wx 68656c6c6f00 @ 0x280
wx 00000000000000008011000005000000 @ 0x2f0
ob-0
oba 0
e io.va=true
iz~cstr.
EOF
EXPECT=<<EOF
0   0x000002f0 0x000011f0 5   6    1.__DATA.__cfstring ascii cstr.hello
EOF
RUN

