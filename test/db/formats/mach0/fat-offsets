NAME=Fat Mach-O x86 section hashes and string file offsets
FILE=bins/mach0/ls-m1
ARGS=-a x86 -b64 -e bin.relocs=false
CMDS=<<EOF
iSj sha1~{0}
ph sha1 0x3a63 @ 0x1000039ac
izj~{97.paddr}
EOF
EXPECT=<<EOF
{"name":"0.__TEXT.__text","size":14947,"vsize":14947,"type":"REGULAR","perm":"-r-x","flags":2147484672,"sha1":"33e7174c48543d45f195a48d6887b2a0cb5525ea","paddr":31148,"vaddr":4294982060}
33e7174c48543d45f195a48d6887b2a0cb5525ea
48875
EOF
RUN

