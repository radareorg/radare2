NAME=Fat Mach-O x86 section extraction preserves bytes
FILE=bins/mach0/ls-m1
ARGS=-a x86 -b64 -e bin.relocs=false -e log.level=0
CMDS=<<EOF
rmrf .tmp/fat-x86-sections
iSx .tmp/fat-x86-sections
e io.va=false
o .tmp/fat-x86-sections/section_0.__TEXT.__text_0.bin
ph sha1 $s @ 0
o-.
rmrf .tmp/fat-x86-sections
EOF
EXPECT=<<EOF
33e7174c48543d45f195a48d6887b2a0cb5525ea
EOF
RUN
