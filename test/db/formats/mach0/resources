NAME=Mach-O embedded resources
FILE=bins/mach0/AppIOSEntitlements.ios
ARGS=-a arm -b 64
CMDS=iuqq
EXPECT=<<EOF
CodeSignature
EOF
RUN

NAME=Mach-O resources from a signed application
FILE=bins/mach0/MASTestApp
CMDS=iuqq
EXPECT=<<EOF
CodeSignature
Certificate
EOF
RUN

NAME=Fat Mach-O x86 signature resource file offset and bytes
FILE=bins/mach0/ls-m1
ARGS=-a x86 -b64 -e bin.relocs=false
CMDS=<<EOF
iuj~{0.paddr}
iuo CodeSignature
e io.va=false
p8 8 @ 0
ph sha1 $s @ 0
EOF
EXPECT=<<EOF
70464
fade0cc000001427
96fa527b7118dd119cdab0ab684ab4f30408acbf
EOF
RUN

NAME=Fat Mach-O x86 certificate resource file offset and bytes
FILE=bins/mach0/ls-m1
ARGS=-a x86 -b64 -e bin.relocs=false
CMDS=<<EOF
iuj~{1.paddr}
iuo Certificate
e io.va=false
p8 8 @ 0
ph sha1 $s @ 0
EOF
EXPECT=<<EOF
71173
fade0b0100001162
bcaf4c25af62f4350f7be0383355e6d60f800854
EOF
RUN

