NAME=msvc RTTI base class descriptor
FILE=-
CMDS=<<EOF
!rabin2 -D msvc "??_R10000A@@8"
!rabin2 -D msvc '??$?_R10000@@YAXXZ'
EOF
EXPECT=<<EOF
A::`RTTI Base Class Descriptor at (1,1,1,1)'
void __cdecl `RTTI Base Class Descriptor at (1,1,1,1)'(void)
EOF
RUN

