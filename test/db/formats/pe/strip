# merged: PE: strip check keeps uncaps clear
NAME=PE: strip check
FILE=bins/pe/hello_world_stripped.exe
CMDS=<<EOF
i~^strip
?e --
i~^uncaps
EOF
EXPECT=<<EOF
stripped true
--
uncaps   false
EOF
RUN

# merged: PE: executable exports mark uncaps
NAME=PE: non strip check
FILE=bins/pe/hello_world_not_stripped.exe
CMDS=<<EOF
i~^strip
?e --
i~^uncaps
EOF
EXPECT=<<EOF
stripped false
--
uncaps   true
EOF
RUN
