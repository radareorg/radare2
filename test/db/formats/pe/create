NAME=create pe64 with a data section
FILE=-
CMDS=<<EOF
rm ./tiny_data.pe__
!rabin2 -C pe64:31c0c3:01020304 -a x86 -b 64 ./tiny_data.pe__
o ./tiny_data.pe__
iI~bits
p8 3 @ entry0
p8 4 @ section..data
e io.va=false
p8 2 @ 0x86
p8 4 @ 0xd0
p8 4 @ 0xd4
o-.
rm ./tiny_data.pe__
EOF
EXPECT=<<EOF
bits     64
31c0c3
01020304
0200
00300000
00020000
EOF
RUN
