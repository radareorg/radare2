NAME=create pe x86-64
FILE=-
CMDS=<<EOF
rm ./tiny_pe64_64.pe__
!rabin2 -C pe64:cc -a x86 -b 64 ./tiny_pe64_64.pe__
o ./tiny_pe64_64.pe__
iI~arch,bits
p8 1 @ entry0
e io.va=false
p8 2 @ 0x84
p8 2 @ 0x98
o-.
rm ./tiny_pe64_64.pe__
EOF
EXPECT=<<EOF
arch     x86
bits     64
cc
6486
0b02
EOF
RUN

