NAME=PE: checksum in the header does not match the computed one
FILE=bins/pe/notputty.exe
CMDS=<<EOF
i~csum
iIj~{}~csum
EOF
EXPECT=<<EOF
cmp.csum 0x001224e3
csum.ok  false
hdr.csum 0x001236c2
  "cmp.csum": "0x001224e3",
  "csum.ok": false,
  "hdr.csum": "0x001236c2",
EOF
RUN

NAME=PE: unset header checksum is not reported as a mismatch
FILE=bins/pe/96emptysections.exe
CMDS=i~csum
EXPECT=<<EOF
cmp.csum 0x0000836c
hdr.csum 0x00000000
EOF
RUN

NAME=PE: checksum with the header at an unaligned offset
FILE=bins/pe/a-unaligned-header.exe
CMDS=i~csum
EXPECT=<<EOF
cmp.csum 0x000083c0
csum.ok  true
hdr.csum 0x000083c0
EOF
RUN
