NAME=PE: checksum 1
FILE=bins/pe/a.exe
ARGS=-A
CMDS=i~csum
EXPECT=<<EOF
cmp.csum 0x00005ee2
csum.ok  true
hdr.csum 0x00005ee2
EOF
RUN

