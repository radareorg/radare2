arg int b @ rsi
var int x @ rbp
var int y @ rax
var int z @ rbx
arg int argc @ rdi
arg char ** argv @ rsi
0x0 version 5 address size 8 offsets 6
0x65 version 5 address size 8 offsets 1
7
0
EOF
RUN

