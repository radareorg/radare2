NAME=jni C++ fixture preserves interface indirection
FILE=bins/elf/librsjni_androix.so
CMDS=<<EOF
e asm.os=android
aa
s sym.JNI_OnLoad
afs
afvt vm
ao @ 0x238~opcode
ao @ 0x244~opcode
tk struct._JavaVM.functions
tk struct.JNIInvokeInterface.GetEnv
tk func.JNIInvokeInterface.GetEnv.arg.0
ao @ 0x260~opcode
ao @ 0x270~opcode
tk struct._JNIEnv.functions
tk struct.JNINativeInterface.FindClass
tk func.JNINativeInterface.FindClass.arg.0
ao @ 0x290~opcode
ao @ 0x294~opcode
tk struct.JNINativeInterface.RegisterNatives
EOF
EXPECT=<<EOF
jint JNI_OnLoad (JavaVM *vm, void *reserved);
JavaVM *
opcode: ldr x8, [x0]
opcode: ldr x8, [x8, 0x30]
const struct JNIInvokeInterface *,0,0
JNIInvokeInterface.GetEnv,48,0
JavaVM *,vm
opcode: ldr x9, [x8]
opcode: ldr x9, [x9, 0x30]
const struct JNINativeInterface *,0,0
JNINativeInterface.FindClass,48,0
JNIEnv *,env
opcode: ldr x8, [x0]
opcode: ldr x8, [x8, 0x6b8]
JNINativeInterface.RegisterNatives,1720,0
EOF
RUN

