NAME=ELF Itanium exception cleanup region
FILE=bins/elf/ClassCpp.out
CMDS=iwj~{[0]}
EXPECT=<<EOF
{"index":0,"source":4713,"from":4778,"to":4872,"handler":4908,"filter":0,"kind":"cleanup"}
EOF
RUN

NAME=rabin2 lists exception regions
FILE=bins/elf/ClassCpp.out
CMDS=!!rabin2 -wr ${R2_FILE}~try.0.
EXPECT=<<EOF
f try.0.1269.from=0x000012aa
f try.0.1269.to=0x00001308
f try.0.1269.cleanup=0x0000132c
EOF
RUN

NAME=exception regions readable and quiet output
FILE=bins/elf/ClassCpp.out
CMDS=<<EOF
iw~0x000012aa
iwq~0x000012aa
!!rabin2 -w ${R2_FILE}~0x000012aa
EOF
EXPECT=<<EOF
0 0x000012aa-0x00001308 cleanup -> 0x0000132c (source 0x00001269)
0x000012aa 0x00001308 0x0000132c
0 0x000012aa-0x00001308 cleanup -> 0x0000132c (source 0x00001269)
EOF
RUN

