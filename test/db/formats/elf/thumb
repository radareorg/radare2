NAME=ELF: arm R_ARM_CALL to a thumb function becomes blx, R_ARM_JUMP24 is left for a veneer
FILE=bins/elf/arm-call-thumb.o
ARGS=-e bin.relocs.apply=true
CMDS=<<EOF
pi 2 @ section..text
px 8 @ section..text~0x
EOF
EXPECT=<<EOF
blx sym.thumbfn
b reloc.thumbfn
0x08000034  0100 00fa feff ffea                      ........
EOF
RUN

