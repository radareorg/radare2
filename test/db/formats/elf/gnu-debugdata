NAME=ELF mini debug symbols rebase without changing file offsets or relocation identities
FILE=bins/elf/ls-toybox
ARGS=-B 0x100000000 -e bin.relocs.apply=true
CMDS=<<EOF
is~_ZL8snprintf[1,2,5]:0
is~ main$[1,2,5]
ir~vsnprintf
EOF
EXPECT=<<EOF
0x00033410 0x100033410 144
0x000384a0 0x1000384a0 100
0x10007b658 0x0007b658 SET_64 1026  __vsnprintf_chk
0x10007b840 0x0007b840 SET_64 1026  vsnprintf
EOF
RUN

