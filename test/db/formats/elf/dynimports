NAME=ELF: x86_64 retpoline -z now imports stop at the plt section or file end
FILE=malloc://2856
CMDS=<<EOF
# a fresh image with dynsym add2, mul2, sub2: st_shndx and st_value zeroed
(fresh;wff bins/elf/pltrel/x86_64-retpoline-now.so;wx 0000 @ 0x21e;wx 0000000000000000 @ 0x220;wx 0000 @ 0x236;wx 0000000000000000 @ 0x238;wx 0000 @ 0x24e;wx 0000000000000000 @ 0x250)
.(fresh)
oba 0
ii
# .plt sh_size 0x50 -> 0x46: sub2's entry is cut one byte short
wx 46 @ 0x948
oba 0
ii
# .plt sh_size 0x46 -> 0x30: mul2's and sub2's entries lie past the section
wx 30 @ 0x948
oba 0
ii
# .dynamic's header becomes a section right after .plt, holding those entries: sh_addr (0x978) 0x1470, sh_offset (0x980) 0x470, sh_size (0x988) 0x20
wx 7014 @ 0x978
wx 7004 @ 0x980
wx 20 @ 0x988
oba 0
ii
# .dynamic's header restored; code LOAD p_filesz/p_memsz (0xd0, 0xd8) 0xc0 -> 0xa0; GNU_STACK (0x1c8) becomes a LOAD of 0x1470 from .comment (0x580), patched with the movs of mul2's and sub2's entries
wx 9024 @ 0x978
wx 9004 @ 0x980
wx c0 @ 0x988
wx a0 @ 0xd0
wx a0 @ 0xd8
wx 01000000 @ 0x1c8
wx 8005 @ 0x1d0
wx 7014 @ 0x1d8
wx 7014 @ 0x1e0
wx 20 @ 0x1e8
wx 20 @ 0x1f0
wx 4c8b1df9100000 @ 0x580
wx 4c8b1df1100000 @ 0x590
oba 0
ii
.(fresh)
# .plt sh_size (0x948) 0x50 -> 0x100000: the slice stops at the file end
wx 0000100000000000 @ 0x948
oba 0
ii
.(fresh)
# control, no sh_size write: sub2's mov (0x480) wiped and planted at 0xb20, in the file's last stride but past the section
wx 00 @ 0x480
wx 4c8b1d510a0000 @ 0xb20
oba 0
ii
.(fresh)
# sh_size oversized and the same plant: the mov is reached through the header
wx 0000100000000000 @ 0x948
wx 00 @ 0x480
wx 4c8b1d510a0000 @ 0xb20
oba 0
ii
.(fresh)
# sh_offset (0x940) 0x440 -> 0x441, sh_size oversized: the planted mov ends exactly at the file end
wx 41 @ 0x940
wx 0000100000000000 @ 0x948
wx 4c8b1d510a0000 @ 0xb21
oba 0
ii
.(fresh)
# sh_offset (0x940) 0x440 -> 0x442, sh_size oversized: the planted mov is cut one byte short by the file end
wx 42 @ 0x940
wx 0000100000000000 @ 0x948
wx 4c8b1d510a0000 @ 0xb22
oba 0
ii
.(fresh)
# .plt sh_size (0x948) 0x50 -> all ones: no entry resolves
wx ffffffffffffffff @ 0x948
oba 0
ii
EOF
