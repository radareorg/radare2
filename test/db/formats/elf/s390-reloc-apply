NAME=ELF s390x: RELATIVE slot keeps its addend when relocs are applied
FILE=bins/elf/hello.sysz
ARGS=-e bin.relocs.apply=true
CMDS=<<EOF
pv8 @ 0x1da8
pv8 @ 0x1db0
pv8 @ 0x1ff0
EOF
EXPECT=<<EOF
0x0000000000000710
0x00000000000006c8
0x0000000000000718
EOF
RUN

NAME=ELF s390x: every RELATIVE and GLOB_DAT slot rebased under -B
FILE=bins/elf/ls-s390x
ARGS=-B 0x100000 -e bin.relocs.apply=true
CMDS=<<EOF
pv8 @ 0x126320
pxQ 0x12d0 @ 0x126318~?0x00000000001
EOF
EXPECT=<<EOF
0x0000000000106328
240
EOF
RUN

NAME=ELF s390x: an applied GLOB_DAT names its symbol, a JMP_SLOT still does not
FILE=bins/elf/ls-s390x
ARGS=-B 0x100000 -e bin.relocs.apply=true
CMDS=<<EOF
pv8 @ 0x126f38
pv8 @ 0x127018
EOF
EXPECT=<<EOF
0x0000000000128fb8
0x000000000000392e
EOF
RUN

NAME=ELF s390x: an applied GLOB_DAT names its symbol unrebased too
FILE=bins/elf/ls-s390x
ARGS=-e bin.relocs.apply=true
CMDS=<<EOF
pv8 @ 0x26f38
om~.got.r2
EOF
EXPECT=<<EOF
0x0000000000028fb8
- 4 fd: 5 +0x00000000 0x00028898 - 0x00029357 rw- rw- .got.r2
EOF
RUN

