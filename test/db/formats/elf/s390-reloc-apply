NAME=ELF s390 31-bit: reloc writes are one 4-byte word
FILE=bins/elf/s390-31-globdat.so
ARGS=-e bin.relocs.apply=true
CMDS=<<EOF
pv4 @ 0x30230
pv4 @ 0x30234
pv4 @ 0x30238
ir~_32
EOF
EXPECT=<<EOF
0x000101c4
0x00030234
0x11223344
0x00030230 0x00000230 SET_32 10    f
0x00030234 0x00000234 ADD_32 12     0x00030234
EOF
RUN

