R2PM_BEGIN

R2PM_DESC "Independently versioned binary fixture"
R2PM_DOC="inline documentation"
R2PM_VERSION_MAP "6.2.40:9.9.9 6.2.2:1.1.0 6.2.4:1.2.3 6.2.6:1.2.3"

R2PM_BINSTALL() {
	printf '%s %s\n' "$R2PM_VERSION" "$R2V"
	test -z "$R2PM_TEST_FAIL"
}

R2PM_BINSTALL_WINDOWS() {
	(echo %R2PM_VERSION% %R2V%)
	if defined R2PM_TEST_FAIL (exit /b 1)
}

R2PM_END
